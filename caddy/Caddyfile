# Reverse proxy fronting the app with automatic HTTPS (Let's Encrypt).
# Hostnames come in as env vars since they're IP-derived (sslip.io) and
# change every time the EC2 instance restarts without an Elastic IP —
# see scripts/ec2-start.sh, which rewrites them and force-recreates this
# container so it re-issues certs for the new names.
#
# Browsers only allow microphone access (getUserMedia) on a secure
# context (https://) — this proxy exists to satisfy that, not for
# encryption's own sake.

{$APP_HOST} {
	reverse_proxy 127.0.0.1:{$CLIENT_INTERNAL_PORT}
}

{$API_HOST} {
	# Caddy's reverse_proxy appends to any X-Forwarded-For a client already
	# sent rather than replacing it, and uvicorn runs with
	# --forwarded-allow-ips=* (see AgentServer/Dockerfile) — meaning it
	# trusts the *whole* chain, including a value the client made up
	# themselves. Overwriting it here to the actual remote IP closes that:
	# the API's rate limiting (app/api/middleware.py) keys on it for
	# unauthenticated requests, and a spoofed header would otherwise let
	# anyone bypass the /auth/login brute-force limiter.
	reverse_proxy 127.0.0.1:{$API_PORT} {
		header_up X-Forwarded-For {http.request.remote.host}
	}
}

{$LIVEKIT_HOST} {
	reverse_proxy 127.0.0.1:7880
}
